{
  // One entry per installed optional gatekeeper Worker name (see
  // `workers.gatekeepers` in deployment.jsonc; defaults to
  // "agentup-os-gatekeeper-<id>"). Copy to `secrets.local.jsonc`, fill in
  // real values, and re-run the deploy. The file is gitignored.
  "agentup-os-gatekeeper-cloudflare": {
    "CLIENT_ID": "your-cloudflare-oauth-client-id",
    "CLIENT_SECRET": "your-cloudflare-oauth-client-secret",
  },
  "agentup-os-gatekeeper-confluence": {
    "CLIENT_ID": "your-confluence-oauth-client-id",
    "CLIENT_SECRET": "your-confluence-oauth-client-secret",
  },
  "agentup-os-gatekeeper-email": {
    "CLIENT_ID": "your-email-oauth-client-id",
    "CLIENT_SECRET": "your-email-oauth-client-secret",
  },
  "agentup-os-gatekeeper-github": {
    "CLIENT_ID": "your-github-oauth-client-id",
    "CLIENT_SECRET": "your-github-oauth-client-secret",
  },
  "agentup-os-gatekeeper-google": {
    "CLIENT_ID": "your-google-oauth-client-id",
    "CLIENT_SECRET": "your-google-oauth-client-secret",
  },
  "agentup-os-gatekeeper-homeassistant": {
    // Home Assistant takes no OAuth app credentials; leave empty.
  },
  "agentup-os-gatekeeper-linear": {
    "CLIENT_ID": "your-linear-oauth-client-id",
    "CLIENT_SECRET": "your-linear-oauth-client-secret",
  },
  "agentup-os-gatekeeper-mcp": {
    // MCP uses dynamic client registration; leave empty unless a specific
    // provider needs its own app credentials.
  },
  "agentup-os-gatekeeper-mcp-portal": {
    // MCP portal takes no default credentials; leave empty unless configured.
  },
  "agentup-os-gatekeeper-notion": {
    "CLIENT_ID": "your-notion-integration-client-id",
    "CLIENT_SECRET": "your-notion-integration-client-secret",
  },
  "agentup-os-gatekeeper-slack": {
    "CLIENT_ID": "your-slack-app-client-id",
    "CLIENT_SECRET": "your-slack-app-client-secret",
  },
  "agentup-os-gatekeeper-spotify": {
    "CLIENT_ID": "your-spotify-oauth-client-id",
    "CLIENT_SECRET": "your-spotify-oauth-client-secret",
  },
  "agentup-os-gatekeeper-supabase": {
    "CLIENT_ID": "your-supabase-oauth-client-id",
    "CLIENT_SECRET": "your-supabase-oauth-client-secret",
  },
  "agentup-os-gatekeeper-zoominfo": {
    "CLIENT_ID": "your-zoominfo-oauth-client-id",
    "CLIENT_SECRET": "your-zoominfo-oauth-client-secret",
  },
}
